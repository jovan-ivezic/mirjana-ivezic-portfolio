---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Portfolio from '../components/Portfolio.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="sr" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    
    <title>Mirjana Ivezić | Sertifikovani dizajner enterijera & 3D vizuelizacija Novi Sad</title>
    <meta name="description" content="Mirjana Ivezić — Sertifikovani dizajner enterijera. Idejna rešenja enterijera, fotorealistična 3D vizuelizacija prostora (3ds Max & Corona) i AutoCAD tehnička dokumentacija. Novi Sad, Beograd i remote." />
    <meta name="keywords" content="dizajn enterijera Novi Sad, sertifikovani dizajner enterijera, 3D vizuelizacija, uredjenje stana, Corona Renderer, 3ds Max enterijer, AutoCAD osnova kuce, dizajn kuhinje po meri, arhitektonski nacrti" />
    <meta name="author" content="Mirjana Ivezić" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href="https://mirjanaivezic.vercel.app/" />
    <meta name="google-site-verification" content="k3mAsRiYiYrlT3hCdWofxUjyIXmqFEvHAAs_KB09dys" />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sr_RS" />
    <meta property="og:site_name" content="Mirjana Ivezić Enterijer" />
    <meta property="og:url" content="https://mirjanaivezic.vercel.app/" />
    <meta property="og:title" content="Mirjana Ivezić | Sertifikovani dizajner enterijera & 3D vizuelizacija" />
    <meta property="og:description" content="Idejna rešenja enterijera, fotorealistična 3D vizuelizacija prostora i AutoCAD tehnička dokumentacija. Novi Sad, Beograd i remote." />
    <meta property="og:image" content="https://mirjanaivezic.vercel.app/images/mirjana-ivezic.jpg" />
    <meta property="og:image:alt" content="Mirjana Ivezić - Sertifikovani dizajner enterijera" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="800" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Mirjana Ivezić | Sertifikovani dizajner enterijera" />
    <meta name="twitter:description" content="Idejna rešenja enterijera, fotorealistična 3D vizuelizacija prostora i AutoCAD tehnička dokumentacija." />
    <meta name="twitter:image" content="https://mirjanaivezic.vercel.app/images/mirjana-ivezic.jpg" />

    <!-- JSON-LD Structured Data for AEO / GEO / Search Engines -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": ["Person", "ProfessionalService"],
            "@id": "https://mirjanaivezic.vercel.app/#person",
            "name": "Mirjana Ivezić",
            "jobTitle": "Sertifikovani dizajner enterijera",
            "description": "Sertifikovani dizajner enterijera specijalizovana za idejna rešenja enterijera, fotorealističnu 3D vizuelizaciju (3ds Max & Corona Renderer) i AutoCAD izvođačku tehničku dokumentaciju.",
            "url": "https://mirjanaivezic.vercel.app/",
            "image": "https://mirjanaivezic.vercel.app/images/mirjana-ivezic.jpg",
            "email": "ivezicm21@gmail.com",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Novi Sad",
              "addressCountry": "RS"
            },
            "areaServed": [
              { "@type": "City", "name": "Novi Sad" },
              { "@type": "City", "name": "Beograd" },
              { "@type": "Country", "name": "Srbija" }
            ],
            "sameAs": [
              "https://www.linkedin.com/in/mirjana-ivezi%C4%87-a28759a5"
            ],
            "knowsAbout": [
              "Dizajn enterijera",
              "3D vizuelizacija",
              "Prostorno planiranje",
              "AutoCAD arhitektonski nacrti",
              "Corona Renderer",
              "3ds Max",
              "Projektovanje kuhinja i nameštaja po meri"
            ],
            "hasOfferCatalog": {
              "@type": "OfferCatalog",
              "name": "Usluge dizajna enterijera",
              "itemListElement": [
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Idejni dizajn i planiranje enterijera",
                    "description": "Prostorna organizacija, koncept rešenja i izbor materijala za stambene i poslovne prostore."
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Fotorealistična 3D vizuelizacija",
                    "description": "Kompjuterski renderi visoke definicije sa fizikalnim svetlom i teksturom materijala u 3ds Max + Corona Renderer-u."
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "AutoCAD 2D tehnička dokumentacija",
                    "description": "Arhitektonske osnove, dispozicija nameštaja, kotiranje i detaljni planovi za izvođače."
                  }
                }
              ]
            }
          }
        ]
      }
    </script>
    
    <!-- Google Fonts Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    
    <script is:inline>
      (function() {
        // Automatically detect theme based on time of day:
        // 07:00 to 19:00 -> Light theme (daylight)
        // 19:00 to 07:00 -> Dark theme (evening/night)
        const hour = new Date().getHours();
        const theme = (hour >= 7 && hour < 19) ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div class="site-content">
      <Navbar />
      <main>
        <Hero />
        <Portfolio />
        <Contact />
      </main>
      <Footer />
    </div>
  </body>
</html>
