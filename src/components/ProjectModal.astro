---
import { projects } from '../data/projects';
---

<div id="project-modal" class="modal-overlay" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="modal-backdrop" id="modal-backdrop"></div>

  <div class="modal-container">
    <div class="modal-card">
      <!-- Top header bar -->
      <div class="modal-topbar">
        <div class="modal-category-badge" id="modal-badge">
          <span class="badge-dot"></span>
          <span id="modal-category-text">3DS MAX</span>
        </div>

        <div class="modal-controls">
          <div class="keyboard-hints">
            <span class="kbd-key">←</span>
            <span class="kbd-key">→</span> kadrovi
            <span class="meta-sep">•</span>
            <span class="kbd-key">ESC</span> zatvori
          </div>
          <button id="modal-close-btn" class="modal-icon-btn" aria-label="Zatvori prozor">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Main modal layout -->
      <div class="modal-body">
        <!-- Visual display column (Gallery) -->
        <div class="modal-visual-col">
          <div class="modal-image-wrapper">
            <img id="modal-image" src="" alt="" class="modal-preview-img" />

            <!-- Gallery Counter Badge -->
            <div class="gallery-counter-badge" id="modal-gallery-badge">
              <span id="modal-gallery-counter">1 / 5</span>
            </div>

            <!-- In-image Prev/Next Arrows -->
            <button id="modal-gallery-prev" class="gallery-arrow arrow-left" aria-label="Prethodna slika u galeriji">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
            </button>
            <button id="modal-gallery-next" class="gallery-arrow arrow-right" aria-label="Sledeća slika u galeriji">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </button>

            <!-- Open Full JPG Link -->
            <a id="modal-view-full-jpg" href="" target="_blank" rel="noopener noreferrer" class="view-full-jpg-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 3h6v6M10 14L21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              </svg>
              <span>Otvori u punoj rezoluciji</span>
            </a>
          </div>

          <!-- Thumbnails Row -->
          <div class="modal-thumbnails-strip" id="modal-thumbnails" aria-label="Slike projekta">
            <!-- Dynamically injected via JavaScript -->
          </div>
        </div>

        <!-- Project metadata and info panel -->
        <div class="modal-info-col">
          <div class="modal-info-content">
            <div class="modal-meta-top">
              <span id="modal-location" class="mono-label">BEOGRAD</span>
              <span class="meta-separator">•</span>
              <span id="modal-year" class="mono-label">2026</span>
              <span class="meta-separator">•</span>
              <span id="modal-area" class="mono-label">52 M²</span>
            </div>

            <h3 id="modal-title" class="modal-title">Naziv projekta</h3>
            <p id="modal-subtitle" class="modal-subtitle">Podnaslov</p>

            <p id="modal-description" class="modal-description">
              Opis projekta...
            </p>

            <!-- Specifications table -->
            <div class="modal-specs-group">
              <span class="specs-heading mono-label">TEHNIČKE SPECIFIKACIJE</span>
              <div id="modal-specs-list" class="modal-specs-list">
                <!-- Injected via JavaScript -->
              </div>
            </div>

            <!-- Software list tags -->
            <div class="modal-software-group">
              <span class="specs-heading mono-label">KORIŠĆENI ALATI</span>
              <div id="modal-software-tags" class="software-tags-row">
                <!-- Injected via JavaScript -->
              </div>
            </div>
          </div>

          <!-- Action bar -->
          <div class="modal-action-bar">
            <a id="modal-fullres-action" href="" target="_blank" rel="noopener noreferrer" class="btn btn-secondary action-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 3h6v6M10 14L21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              </svg>
              <span>Uvećan prikaz</span>
            </a>

            <a href="#contact" id="modal-contact-btn" class="btn btn-primary action-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
              <span>Zatraži ponudu / Kontakt</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Navigation footer: Previous / Next Project -->
      <div class="modal-nav-footer">
        <button id="modal-prev-btn" class="nav-control-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>Prethodni projekat</span>
        </button>

        <span class="modal-counter mono-label" id="modal-counter">1 / 4</span>

        <button id="modal-next-btn" class="nav-control-btn">
          <span>Sledeći projekat</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ projects }}>
  window.__PORTFOLIO_PROJECTS__ = projects;
</script>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-smooth);
  }

  .modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: var(--bg-modal-backdrop);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .modal-container {
    position: relative;
    width: 100%;
    max-width: 1140px;
    max-height: calc(100vh - 40px);
    display: flex;
    z-index: 2;
  }

  .modal-card {
    width: 100%;
    background: var(--bg-modal-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    max-height: calc(100vh - 40px);
    color: var(--text-primary);
  }

  .modal-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .modal-category-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
  }

  .badge-3ds {
    background: var(--tag-3ds-bg);
    border: 1px solid rgba(242, 153, 74, 0.35);
    color: var(--tag-3ds);
  }

  .badge-cad {
    background: var(--tag-cad-bg);
    border: 1px solid rgba(77, 156, 255, 0.35);
    color: var(--tag-cad);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .modal-controls {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .keyboard-hints {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .meta-sep {
    color: var(--border-subtle);
    font-size: 10px;
  }

  .kbd-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    color: var(--text-secondary);
  }

  .modal-icon-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .modal-icon-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
  }

  .modal-body {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    flex: 1;
    overflow-y: auto;
    min-height: 0;
  }

  /* Gallery visual column */
  .modal-visual-col {
    background: var(--bg-surface);
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    padding: 20px;
    gap: 14px;
  }

  .modal-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--border-subtle);
  }

  .modal-preview-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: opacity 180ms ease;
  }

  .gallery-counter-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 9px;
    border-radius: var(--radius-full);
    background: rgba(8, 9, 10, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: #fff;
    backdrop-filter: blur(8px);
    pointer-events: none;
  }

  /* Gallery Prev / Next Arrows */
  .gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(12, 13, 15, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all var(--transition-fast);
    opacity: 0.85;
    z-index: 2;
  }

  .gallery-arrow:hover {
    opacity: 1;
    background: rgba(12, 13, 15, 0.95);
    transform: translateY(-50%) scale(1.08);
  }

  .arrow-left {
    left: 12px;
  }

  .arrow-right {
    right: 12px;
  }

  .view-full-jpg-link {
    position: absolute;
    bottom: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background: rgba(12, 13, 15, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 11.5px;
    font-weight: 500;
    color: #fff;
    backdrop-filter: blur(8px);
    transition: all var(--transition-fast);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    z-index: 2;
  }

  .view-full-jpg-link:hover {
    background: rgba(12, 13, 15, 0.95);
    transform: translateY(-1px);
  }

  /* Thumbnails strip */
  .modal-thumbnails-strip {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }

  :global(.thumb-btn) {
    flex: 0 0 76px;
    height: 52px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    background: var(--bg-card);
    cursor: pointer;
    transition: border-color var(--transition-fast), transform var(--transition-fast), opacity var(--transition-fast);
    opacity: 0.65;
  }

  :global(.thumb-btn:hover) {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  :global(.thumb-btn.active) {
    opacity: 1;
    border-color: var(--accent-orange);
    box-shadow: 0 0 0 2px rgba(242, 153, 74, 0.25);
  }

  :global(.thumb-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Info Column */
  .modal-info-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--bg-modal-surface);
  }

  .modal-info-content {
    padding: 24px 28px;
    overflow-y: auto;
  }

  .modal-meta-top {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .meta-separator {
    color: var(--text-tertiary);
    font-size: 11px;
  }

  .modal-title {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 4px;
    line-height: 1.25;
  }

  .modal-subtitle {
    font-size: 13.5px;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .modal-description {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .specs-heading {
    display: block;
    margin-bottom: 6px;
    font-size: 10.5px;
  }

  .modal-specs-group {
    margin-bottom: 18px;
  }

  .modal-specs-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }

  :global(.modal-spec-row) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 12px;
    padding: 4px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  :global(.modal-spec-row:last-child) {
    border-bottom: none;
  }

  :global(.spec-row-label) {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  :global(.spec-row-val) {
    color: var(--text-primary);
    font-weight: 500;
    text-align: right;
  }

  .software-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  :global(.modal-tag-pill) {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  /* Action bar */
  .modal-action-bar {
    padding: 16px 28px;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .action-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    font-size: 13px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    cursor: pointer;
  }

  /* Footer Navigation */
  .modal-nav-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 20px;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .nav-control-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-secondary);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast);
    cursor: pointer;
    background: none;
    border: none;
  }

  .nav-control-btn:hover {
    color: var(--text-primary);
  }

  .modal-counter {
    color: var(--text-tertiary);
  }

  @media (max-width: 920px) {
    .modal-body {
      grid-template-columns: 1fr;
    }
    .modal-visual-col {
      border-right: none;
      border-bottom: 1px solid var(--border-subtle);
      padding: 16px;
    }
    .modal-info-content {
      padding: 16px 20px;
    }
    .modal-action-bar {
      padding: 14px 20px;
      flex-direction: column;
    }
    .action-btn {
      width: 100%;
    }
    .keyboard-hints {
      display: none;
    }
  }
</style>
