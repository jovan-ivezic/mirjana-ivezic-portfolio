---
import { projects } from '../data/projects';
---

<div id="project-modal" class="modal-overlay" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="modal-backdrop" id="modal-backdrop"></div>

  <div class="modal-container">
    <div class="modal-card">
      <!-- Top header bar -->
      <div class="modal-topbar">
        <div class="modal-category-badge" id="modal-badge">
          <span class="badge-dot"></span>
          <span id="modal-category-text">3DS MAX</span>
        </div>

        <div class="modal-controls">
          <div class="keyboard-hints">
            <span class="kbd-key">←</span>
            <span class="kbd-key">→</span> kadrovi
            <span class="meta-sep">•</span>
            <span class="kbd-key">ESC</span> zatvori
          </div>
          <button id="modal-close-btn" class="modal-icon-btn" aria-label="Zatvori prozor">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Main modal layout -->
      <div class="modal-body">
        <!-- Visual display column (Gallery) -->
        <div class="modal-visual-col">
          <div class="modal-image-wrapper">
            <img id="modal-image" src="" alt="" class="modal-preview-img" title="Kliknite za prikaz preko celog ekrana" />

            <!-- Gallery Counter Badge -->
            <div class="gallery-counter-badge" id="modal-gallery-badge">
              <span id="modal-gallery-counter">1 / 4</span>
            </div>

            <!-- In-image Prev/Next Arrows -->
            <button id="modal-gallery-prev" class="gallery-arrow arrow-left" aria-label="Prethodna slika u galeriji">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
            </button>
            <button id="modal-gallery-next" class="gallery-arrow arrow-right" aria-label="Sledeća slika u galeriji">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </button>

            <!-- Lightbox trigger button -->
            <button type="button" id="modal-view-full-jpg" class="view-full-jpg-link" aria-label="Uvećaj prikaz preko celog ekrana">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 3h6v6M10 14L21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              </svg>
              <span>Uvećan prikaz</span>
            </button>
          </div>

          <!-- Thumbnails Row -->
          <div class="modal-thumbnails-strip" id="modal-thumbnails" aria-label="Slike projekta">
            <!-- Dynamically injected via JavaScript -->
          </div>
        </div>

        <!-- Project metadata and info panel -->
        <div class="modal-info-col">
          <div class="modal-info-content">
            <div class="modal-meta-top">
              <span id="modal-location" class="mono-label">NOVI SAD</span>
              <span class="meta-separator">•</span>
              <span id="modal-year" class="mono-label">2026</span>
              <span class="meta-separator">•</span>
              <span id="modal-area" class="mono-label">52 M²</span>
            </div>

            <h3 id="modal-title" class="modal-title">Naziv projekta</h3>
            <p id="modal-subtitle" class="modal-subtitle">Podnaslov</p>

            <p id="modal-description" class="modal-description">
              Opis projekta...
            </p>

            <!-- Specifications table -->
            <div class="modal-specs-group">
              <span class="specs-heading mono-label">TEHNIČKE SPECIFIKACIJE</span>
              <div id="modal-specs-list" class="modal-specs-list">
                <!-- Injected via JavaScript -->
              </div>
            </div>

            <!-- Software list tags -->
            <div class="modal-software-group">
              <span class="specs-heading mono-label">KORIŠĆENI ALATI</span>
              <div id="modal-software-tags" class="software-tags-row">
                <!-- Injected via JavaScript -->
              </div>
            </div>
          </div>

          <!-- Action bar -->
          <div class="modal-action-bar">
            <button type="button" id="modal-fullres-action" class="btn btn-secondary action-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 3h6v6M10 14L21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              </svg>
              <span>Uvećan prikaz</span>
            </button>

            <a href="#contact" id="modal-contact-btn" class="btn btn-primary action-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
              <span>Zatraži ponudu / Kontakt</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Navigation footer: Previous / Next Project -->
      <div class="modal-nav-footer">
        <button id="modal-prev-btn" class="nav-control-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>Prethodni projekat</span>
        </button>

        <span class="modal-counter mono-label" id="modal-counter">1 / 4</span>

        <button id="modal-next-btn" class="nav-control-btn">
          <span>Sledeći projekat</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Fullscreen In-App Lightbox Overlay -->
<div id="lightbox-overlay" class="lightbox-overlay" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="lightbox-backdrop" id="lightbox-backdrop"></div>

  <div class="lightbox-topbar">
    <div class="lightbox-meta">
      <span id="lightbox-title" class="lightbox-title">Naziv projekta</span>
      <span class="meta-sep">•</span>
      <span id="lightbox-counter" class="mono-label lightbox-counter-tag">1 / 4</span>
    </div>

    <button type="button" id="lightbox-close-btn" class="lightbox-close-btn" aria-label="Zatvori uvećan prikaz">
      <span class="kbd-key">ESC</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="lightbox-stage">
    <button type="button" id="lightbox-prev-btn" class="lightbox-nav-btn prev-btn" aria-label="Prethodni kadar">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
    </button>

    <div class="lightbox-img-frame" id="lightbox-img-frame">
      <img id="lightbox-img" src="" alt="" class="lightbox-img" />
    </div>

    <button type="button" id="lightbox-next-btn" class="lightbox-nav-btn next-btn" aria-label="Sledeći kadar">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    </button>
  </div>
</div>

<script is:inline define:vars={{ projects }}>
  window.__PORTFOLIO_PROJECTS__ = projects;
</script>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-smooth);
    overflow: hidden;
    max-width: 100vw;
  }

  .modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: var(--bg-modal-backdrop);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .modal-container {
    position: relative;
    width: 100%;
    max-width: 1140px;
    max-height: calc(100vh - 40px);
    display: flex;
    z-index: 2;
    min-width: 0;
    overflow: hidden;
  }

  .modal-card {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    background: var(--bg-modal-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    max-height: calc(100vh - 40px);
    color: var(--text-primary);
  }

  .modal-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .modal-category-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
  }

  .badge-3ds {
    background: var(--tag-3ds-bg);
    border: 1px solid rgba(242, 153, 74, 0.35);
    color: var(--tag-3ds);
  }

  .badge-cad {
    background: var(--tag-cad-bg);
    border: 1px solid rgba(77, 156, 255, 0.35);
    color: var(--tag-cad);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .modal-controls {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .keyboard-hints {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .meta-sep {
    color: var(--border-subtle);
    font-size: 10px;
  }

  .kbd-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    color: var(--text-secondary);
  }

  .modal-icon-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .modal-icon-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
  }

  .modal-body {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 0;
    min-width: 0;
    width: 100%;
    max-width: 100%;
  }

  /* Gallery visual column */
  .modal-visual-col {
    background: var(--bg-surface);
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    padding: 20px;
    gap: 14px;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .modal-image-wrapper {
    position: relative;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--border-subtle);
    cursor: zoom-in;
    min-width: 0;
  }

  .modal-preview-img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
    display: block;
    transition: opacity 180ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-image-wrapper:hover .modal-preview-img {
    transform: scale(1.015);
  }

  .gallery-counter-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 9px;
    border-radius: var(--radius-full);
    background: rgba(8, 9, 10, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: #fff;
    backdrop-filter: blur(8px);
    pointer-events: none;
  }

  /* Gallery Prev / Next Arrows */
  .gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(12, 13, 15, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all var(--transition-fast);
    opacity: 0.85;
    z-index: 2;
  }

  .gallery-arrow:hover {
    opacity: 1;
    background: rgba(12, 13, 15, 0.95);
    transform: translateY(-50%) scale(1.08);
  }

  .arrow-left {
    left: 12px;
  }

  .arrow-right {
    right: 12px;
  }

  .view-full-jpg-link {
    position: absolute;
    bottom: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background: rgba(12, 13, 15, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 11.5px;
    font-weight: 500;
    color: #fff;
    backdrop-filter: blur(8px);
    transition: all var(--transition-fast);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    z-index: 2;
    cursor: pointer;
  }

  .view-full-jpg-link:hover {
    background: rgba(12, 13, 15, 1);
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.5);
  }

  /* Thumbnails strip */
  .modal-thumbnails-strip {
    position: relative;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding-bottom: 4px;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
    box-sizing: border-box;
  }

  :global(.thumb-btn) {
    flex: 0 0 76px;
    height: 52px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    background: var(--bg-card);
    cursor: pointer;
    transition: border-color var(--transition-fast), transform var(--transition-fast), opacity var(--transition-fast);
    opacity: 0.65;
  }

  :global(.thumb-btn:hover) {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  :global(.thumb-btn.active) {
    opacity: 1;
    border-color: var(--accent-orange);
    box-shadow: 0 0 0 2px rgba(242, 153, 74, 0.25);
  }

  :global(.thumb-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Info Column */
  .modal-info-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--bg-modal-surface);
    min-width: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .modal-info-content {
    padding: 24px 28px;
    overflow-y: auto;
    overflow-x: hidden;
    min-width: 0;
    box-sizing: border-box;
  }

  .modal-meta-top {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .meta-separator {
    color: var(--text-tertiary);
    font-size: 11px;
  }

  .modal-title {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 4px;
    line-height: 1.25;
    word-break: break-word;
  }

  .modal-subtitle {
    font-size: 13.5px;
    color: var(--text-secondary);
    margin-bottom: 16px;
    word-break: break-word;
  }

  .modal-description {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 20px;
    word-break: break-word;
  }

  .specs-heading {
    display: block;
    margin-bottom: 6px;
    font-size: 10.5px;
  }

  .modal-specs-group {
    margin-bottom: 18px;
  }

  .modal-specs-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }

  :global(.modal-spec-row) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 12px;
    padding: 4px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  :global(.modal-spec-row:last-child) {
    border-bottom: none;
  }

  :global(.spec-row-label) {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  :global(.spec-row-val) {
    color: var(--text-primary);
    font-weight: 500;
    text-align: right;
  }

  .software-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  :global(.modal-tag-pill) {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  /* Action bar */
  .modal-action-bar {
    padding: 16px 28px;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    gap: 12px;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
  }

  .action-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    font-size: 13px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    cursor: pointer;
  }

  /* Footer Navigation */
  .modal-nav-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 20px;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
  }

  .nav-control-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-secondary);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast);
    cursor: pointer;
    background: none;
    border: none;
  }

  .nav-control-btn:hover {
    color: var(--text-primary);
  }

  .modal-counter {
    color: var(--text-tertiary);
  }

  /* Fullscreen In-App Lightbox */
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-smooth);
  }

  .lightbox-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 7, 8, 0.95);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  .lightbox-topbar {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 32px;
  }

  .lightbox-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #fff;
  }

  .lightbox-title {
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .lightbox-counter-tag {
    color: rgba(255, 255, 255, 0.6);
  }

  .lightbox-close-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .lightbox-close-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .lightbox-stage {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px 24px;
    min-height: 0;
  }

  .lightbox-img-frame {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 10px;
  }

  .lightbox-img {
    max-width: 92vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.8);
    transition: opacity 120ms ease, transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox-nav-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: all var(--transition-fast);
    flex-shrink: 0;
    margin: 0 16px;
  }

  .lightbox-nav-btn:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.4);
    transform: scale(1.08);
