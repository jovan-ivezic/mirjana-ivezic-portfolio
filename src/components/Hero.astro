---
---
<section class="hero-section">
  <div class="container">
    <div class="hero-card">
      <!-- Portrait Column -->
      <div class="hero-image-col">
        <div class="portrait-frame">
          <img 
            src="/images/mirjana-ivezic.jpg" 
            alt="Mirjana Ivezić - Dizajner enterijera" 
            class="portrait-img"
          />
        </div>
      </div>

      <!-- About & Intro Column -->
      <div class="hero-text-col">
        <h1 class="hero-name">Mirjana Ivezić</h1>
        <p class="hero-role">Dizajner enterijera & 3D vizuelizacija</p>

        <p class="hero-bio">
          Specijalizovana za prostorni dizajn, fotorealističnu 3D vizuelizaciju u programu <strong>3ds Max + Corona</strong> i izradu preciznih izvođačkih planova u <strong>AutoCAD-u</strong>.
        </p>

        <div class="hero-skills-row">
          <span class="skill-tag">3ds Max + Corona</span>
          <span class="skill-tag">AutoCAD</span>
          <span class="skill-tag">Photoshop</span>
          <span class="skill-tag">Razrada detalja</span>
        </div>

        <div class="hero-actions">
          <a href="#portfolio" class="btn btn-primary">
            <span>Pogledaj radove</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 13l5 5 5-5M12 18V6"/>
            </svg>
          </a>

          <a href="/downloads/mirjana-ivezic-cv.pdf" download="mirjana-ivezic-cv.pdf" class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
            </svg>
            <span>Preuzmi CV</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(32px, 4.5vw, 56px);
    padding-bottom: clamp(36px, 5vw, 64px);
  }

  .hero-card {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: clamp(28px, 4.5vw, 56px);
    align-items: center;
  }

  .hero-image-col {
    position: relative;
  }

  .portrait-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--card-shadow);
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .portrait-frame:hover .portrait-img {
    transform: scale(1.02);
  }

  .hero-text-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-name {
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .hero-role {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 18px;
  }

  .hero-bio {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 540px;
    margin-bottom: 22px;
  }

  .hero-bio strong {
    color: var(--text-primary);
    font-weight: 500;
  }

  .hero-skills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 28px;
  }

  .skill-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 4px 9px;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 820px) {
    .hero-card {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .portrait-frame {
      max-width: 300px;
      margin: 0 auto;
    }
    .hero-text-col {
      align-items: center;
      text-align: center;
    }
    .hero-skills-row {
      justify-content: center;
    }
    .hero-actions {
      justify-content: center;
    }
  }
</style>
